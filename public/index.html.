<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#10100d">
  <meta name="description" content="Ajude a Tribo de Judá a chegar ao Campori Sul-Americano 2026 em Barretos. Acompanhe a meta e contribua via Pix.">
  <title>Tribo de Judá • Rumo ao Campori 2026</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--gold:#f7a900;--gold2:#ffca57;--bg:#0b0c0a;--panel:#151611;--muted:#a8a89e;--line:#303126;--white:#f7f4e9}
    *{box-sizing:border-box}
    body{margin:0;background:radial-gradient(ellipse at 10% 0%,#25200f 0,transparent 38%),var(--bg);color:var(--white);font-family:Inter,system-ui,sans-serif}
    .wrap{width:min(1240px,100% - 32px);margin:0 auto;padding:24px 0 42px}
    header{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:22px}
    .brand{display:flex;align-items:center;gap:12px}
    .emblem{width:44px;height:44px;border:1px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:22px;box-shadow:0 0 24px #f7a90024}
    .brand strong{font:800 25px/1 "Barlow Condensed",sans-serif;letter-spacing:1.5px}
    .brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:4px;margin-top:5px}
    .live{font-size:11px;color:#b9e5a9;border:1px solid #42613c;background:#172116;padding:8px 11px;border-radius:999px;white-space:nowrap}
    .live:before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:#85db67;margin-right:7px;box-shadow:0 0 10px #85db67}
    .hero{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(300px,.85fr);gap:18px;align-items:stretch}
    .map-card{position:relative;border:1px solid #49412a;border-radius:18px;overflow:hidden;background:#111;min-height:0;box-shadow:0 22px 70px #0008}
    .map-img{width:100%;height:auto;aspect-ratio:3/2;min-height:0;object-fit:cover;display:block;filter:saturate(.92)}
    .map-shade{position:absolute;inset:0;background:linear-gradient(0deg,#080907a8,transparent 36%,#08090718);pointer-events:none}
    .map-caption{position:absolute;left:18px;bottom:16px;right:18px;display:flex;justify-content:space-between;align-items:end;gap:12px;text-shadow:0 2px 10px #000}
    .route-label{font-size:11px;letter-spacing:2px;color:#fff9;text-transform:uppercase}
    .route-title{font:800 clamp(23px,3vw,38px)/.98 "Barlow Condensed",sans-serif;margin-top:5px}
    .route-title span{color:var(--gold)}
    .bus-marker{position:absolute;left:80%;top:22%;transform:translate(-50%,-50%);z-index:4;transition:left 1.1s cubic-bezier(.2,.8,.2,1),top 1.1s cubic-bezier(.2,.8,.2,1);filter:drop-shadow(0 0 12px #ffb300)}
    .bus-marker .bus{font-size:28px;background:#111d;border:1px solid #ffbd36;border-radius:10px;padding:7px 9px;display:block}
    .map-live-overlay{position:absolute;left:3%;top:4%;width:25%;height:23%;min-width:130px;min-height:70px;z-index:3;background:rgba(5,6,5,.98);border:1px solid var(--gold);border-radius:8px;padding:7px 9px;box-shadow:0 6px 20px #0009;overflow:hidden}
    .map-live-overlay .map-brand{font:900 clamp(12px,1.6vw,22px)/.95 "Barlow Condensed",sans-serif;color:var(--gold);letter-spacing:.5px}
    .map-live-overlay .map-sub{font-size:7px;letter-spacing:2px;margin-top:4px;color:#eee}
    .map-live-overlay .map-live-number{font:800 clamp(13px,1.7vw,22px)/1 "Barlow Condensed",sans-serif;color:var(--gold);margin-top:7px}
    .map-live-overlay .map-live-number span{font:500 clamp(8px,1vw,12px) Inter,sans-serif;color:#ddd}
    .map-live-overlay .mini-progress{height:5px;background:#333;border-radius:99px;overflow:hidden;margin:5px 0}
    .map-live-overlay .mini-progress-fill{height:100%;width:0;background:var(--gold);transition:width .8s}
    .map-live-overlay .map-live-total{font-size:9px;color:#f4f0e7;text-align:center}
    .map-note{position:absolute;top:16px;right:16px;background:#0a0b09d9;border:1px solid #f7a9007a;padding:9px 11px;border-radius:10px;font-size:11px;color:#ffe4a2;backdrop-filter:blur(8px)}
    .side{display:flex;flex-direction:column;gap:14px}
    .panel{background:linear-gradient(145deg,#191a14,#11120f);border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 18px 50px #0003}
    .eyebrow{color:var(--gold);font-size:10px;font-weight:700;letter-spacing:2.6px;text-transform:uppercase}
    h1{font:900 clamp(30px,4vw,48px)/.9 "Barlow Condensed",sans-serif;margin:10px 0 12px;letter-spacing:.3px;text-transform:uppercase}
    h1 span{color:var(--gold)}
    .lead{color:#c8c7bd;font-size:13px;line-height:1.65;margin:0}
    .amount-row{display:flex;align-items:end;justify-content:space-between;gap:8px;margin-top:22px}
    .amount{font:800 clamp(28px,3.3vw,39px)/1 "Barlow Condensed",sans-serif;color:var(--gold2)}
    .goal{font-size:12px;color:var(--muted);padding-bottom:3px}
    .progress{height:12px;background:#2a2b23;border:1px solid #454638;border-radius:99px;overflow:hidden;margin:12px 0 9px}
    .progress-fill{height:100%;width:0;background:linear-gradient(90deg,#e68b00,#ffd35a);border-radius:99px;transition:width .8s ease;box-shadow:0 0 16px #f7a90080}
    .progress-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:11px}
    .stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:17px}
    .stat{background:#0c0d0b;border:1px solid #292a21;border-radius:12px;padding:12px}
    .stat span{display:block;color:var(--muted);font-size:10px;margin-bottom:7px}
    .stat strong{font-size:17px}
    .donate h2{font:800 26px "Barlow Condensed",sans-serif;margin:0 0 6px}
    .donate p{font-size:12px;color:var(--muted);line-height:1.5;margin:0 0 15px}
    .presets{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
    .preset{background:#202118;color:#eee;border:1px solid #3b3c2c;border-radius:10px;padding:11px 6px;font-weight:700;cursor:pointer}
    .preset.active,.preset:hover{border-color:var(--gold);color:var(--gold2);background:#302613}
    label{display:block;font-size:11px;color:#d6d4c8;margin:12px 0 6px}
    input{width:100%;border:1px solid #3d3e32;background:#0c0d0b;color:white;border-radius:10px;padding:12px 13px;font:inherit;font-size:13px;outline:none}
    input:focus{border-color:var(--gold)}
    .btn{width:100%;border:0;border-radius:11px;background:linear-gradient(100deg,#f4a300,#ffd15a);color:#201700;font-weight:800;padding:14px 16px;margin-top:14px;cursor:pointer;box-shadow:0 8px 26px #e99b0030}
    .btn:disabled{opacity:.6;cursor:wait}
    .pix-area{display:none;margin-top:16px;padding:14px;background:#0b0c0a;border:1px solid #3b3c2d;border-radius:12px;text-align:center}
    .pix-area img{width:180px;height:180px;object-fit:contain;background:white;border-radius:8px;padding:8px}
    .pix-code{width:100%;margin-top:10px;font-size:10px}
    .copy{background:#26271e;border:1px solid #414231;color:#fff;border-radius:9px;padding:10px 12px;margin-top:8px;cursor:pointer}
    .notice{font-size:11px;color:var(--muted);line-height:1.55;margin-top:12px}
    .footer{display:flex;justify-content:space-between;gap:12px;margin-top:18px;color:#858579;font-size:10px;line-height:1.5}
    .footer strong{color:#d5cdb8}
    .toast{display:none;margin-top:10px;border-radius:9px;background:#2b2110;border:1px solid #79551a;color:#ffe3a2;padding:10px;font-size:12px}
    @media(max-width:850px){.hero{grid-template-columns:1fr}.map-card,.map-img{min-height:0}.side{display:grid;grid-template-columns:1fr 1fr}.intro{grid-column:1/-1}.wrap{width:min(100% - 22px,640px)}}
    @media(max-width:560px){.wrap{padding-top:16px}.brand strong{font-size:22px}.live{font-size:9px;padding:7px 8px}.map-card,.map-img{min-height:0}.map-caption{left:12px;bottom:12px}.map-note{top:10px;right:10px;font-size:9px}.side{display:flex}.panel{padding:18px}.amount{font-size:34px}.footer{flex-direction:column}}
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="brand">
        <div class="emblem">✝</div>
        <div><strong>TRIBO DE JUDÁ</strong><small>CAMPORI 2026</small></div>
      </div>
      <div class="live">Acompanhamento ao vivo</div>
    </header>

    <main class="hero">
      <section class="map-card" aria-label="Mapa da jornada de Brumadinho a Barretos">
        <img class="map-img" src="/mapa-tribo-juda.png" alt="Mapa ilustrado da rota de Brumadinho a Barretos com fotos estilo Polaroid">
        <div class="map-shade"></div>
        <div class="map-live-overlay" aria-label="Arrecadação atual">
          <div class="map-brand">TRIBO DE JUDÁ</div>
          <div class="map-sub">CAMPORI 2026</div>
          <div class="map-live-number"><span id="mapPercent">0%</span> <span>DA META</span></div>
          <div class="mini-progress"><div class="mini-progress-fill" id="mapProgressFill"></div></div>
          <div class="map-live-total" id="mapRaised">R$ 0 / R$ 12.000</div>
        </div>
        <div class="map-note">NOSSA JORNADA • 1.030 KM APROX.</div>
        <div class="bus-marker" id="busMarker" aria-label="Posição do ônibus">
          <span class="bus">🚌</span>
        </div>
        <div class="map-caption">
          <div><div class="route-label">Minas Gerais → São Paulo</div><div class="route-title">RUMO A <span>BARRETOS</span></div></div>
          <div class="route-label">Meta da missão</div>
        </div>
      </section>

      <aside class="side">
        <section class="panel intro">
          <div class="eyebrow">Uma jornada de fé e união</div>
          <h1>Vamos levar a <span>Tribo de Judá</span> ao Campori!</h1>
          <p class="lead">Cada contribuição aproxima nossos desbravadores de Barretos. Acompanhe o ônibus avançando pela rota conforme as doações confirmadas chegam.</p>
          <div class="amount-row"><div class="amount" id="raised">R$ 0</div><div class="goal">META R$ 12.000</div></div>
          <div class="progress"><div class="progress-fill" id="progressFill"></div></div>
          <div class="progress-meta"><span id="percent">0% da meta</span><span id="remaining">Faltam R$ 12.000</span></div>
          <div class="stats">
            <div class="stat"><span>DOAÇÕES CONFIRMADAS</span><strong id="count">0</strong></div>
            <div class="stat"><span>JORNADA PERCORRIDA</span><strong id="distance">0 km</strong></div>
          </div>
        </section>

        <section class="panel donate">
          <div class="eyebrow">Faça parte da jornada</div>
          <h2>Contribua com um Pix</h2>
          <p>Escolha o valor da sua contribuição. Você será encaminhado ao ambiente seguro do Mercado Pago para concluir o pagamento. A arrecadação só aumenta depois que o pagamento for confirmado.</p>
          <div class="donation-options" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:16px 0">
            <button class="btn amount-choice" type="button" data-amount="10">R$ 10</button>
            <button class="btn amount-choice" type="button" data-amount="25">R$ 25</button>
            <button class="btn amount-choice" type="button" data-amount="50">R$ 50</button>
            <button class="btn amount-choice" type="button" data-amount="100">R$ 100</button>
            <button class="btn amount-choice" type="button" data-amount="200">R$ 200</button>
            <button class="btn amount-choice" type="button" data-amount="500">R$ 500</button>
          </div>
          <label for="customAmount" style="display:block;margin:10px 0 6px;font-size:12px;color:#c5c8b8">OU DIGITE OUTRO VALOR (R$)</label>
          <input id="customAmount" type="number" inputmode="decimal" min="1" max="100000" step="0.01" placeholder="Ex.: 35,00" style="box-sizing:border-box;width:100%;padding:13px;border-radius:10px;border:1px solid #45483b;background:#10110e;color:#fff;font:inherit;margin-bottom:12px">
          <button class="btn" type="button" id="donateButton" style="width:100%">Continuar para pagar com Pix</button>
          <div class="toast" id="toast" role="status" aria-live="polite"></div>
          <p class="notice">O site registra apenas pagamentos aprovados pelo Mercado Pago. Pagamentos pendentes, recusados ou cancelados não entram na meta.</p>
        </section>
      </aside>
    </main>

    <footer class="footer">
      <span><strong>TRIBO DE JUDÁ • CAMPORI 2026</strong><br>Unidos por um propósito. Juntos até Barretos.</span>
      <span>Meta: R$ 12.000 · Rota ilustrativa: aprox. 1.030 km<br>Os dados atualizam automaticamente quando o servidor recebe confirmações.</span>
    </footer>
  </div>

<script>
  const goal = 12000;
  const brl = value => Number(value).toLocaleString("pt-BR",{style:"currency",currency:"BRL",maximumFractionDigits:2});
  async function refreshStatus() {
    try {
      const r = await fetch("/api/status", {cache:"no-store"});
      if (!r.ok) return;
      const s = await r.json();
      const pct = Math.min(100, s.percent || 0);
      document.getElementById("raised").textContent = brl(s.raised);
      document.getElementById("remaining").textContent = "Faltam " + brl(s.remaining);
      document.getElementById("percent").textContent = pct.toLocaleString("pt-BR",{maximumFractionDigits:2}) + "% da meta";
      document.getElementById("progressFill").style.width = pct + "%";
      document.getElementById("mapPercent").textContent = pct.toLocaleString("pt-BR",{maximumFractionDigits:2}) + "%";
      document.getElementById("mapProgressFill").style.width = pct + "%";
      document.getElementById("mapRaised").textContent = brl(s.raised) + " / R$ 12.000";
      document.getElementById("count").textContent = s.paymentsCount || 0;
      document.getElementById("distance").textContent = Math.round(1030 * pct / 100).toLocaleString("pt-BR") + " km";
      const x = 80 - (pct * .64);
      const y = 22 + (pct * .32);
      const bus = document.getElementById("busMarker");
      bus.style.left = Math.max(8, Math.min(80, x)) + "%";
      bus.style.top = Math.max(16, Math.min(72, y)) + "%";
    } catch (_) {}
  }
  const amountButtons = [...document.querySelectorAll(".amount-choice")];
  const customAmount = document.getElementById("customAmount");
  const donateButton = document.getElementById("donateButton");
  const toast = document.getElementById("toast");
  let selectedAmount = 25;
  amountButtons.forEach(button => {
    button.addEventListener("click", () => {
      selectedAmount = Number(button.dataset.amount);
      customAmount.value = "";
      amountButtons.forEach(b => b.style.borderColor = b === button ? "#d9b96e" : "");
      toast.style.display = "none";
    });
  });
  customAmount.addEventListener("input", () => {
    amountButtons.forEach(b => b.style.borderColor = "");
  });
  donateButton.addEventListener("click", async () => {
    const typed = customAmount.value.trim();
    const amount = typed ? Number(typed.replace(",", ".")) : selectedAmount;
    if (!Number.isFinite(amount) || amount < 1 || amount > 100000) {
      toast.textContent = "Informe uma contribuição entre R$ 1,00 e R$ 100.000,00.";
      toast.style.display = "block";
      return;
    }
    donateButton.disabled = true;
    donateButton.textContent = "Preparando pagamento...";
    toast.style.display = "none";
    try {
      const response = await fetch("/api/create-payment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ amount })
      });
      const data = await response.json();
      if (!response.ok || !data.url) throw new Error(data.error || "Não foi possível iniciar o pagamento.");
      window.location.href = data.url;
    } catch (error) {
      toast.textContent = error.message || "Ocorreu um erro. Tente novamente.";
      toast.style.display = "block";
      donateButton.disabled = false;
      donateButton.textContent = "Continuar para pagar com Pix";
    }
  });
  refreshStatus();
  setInterval(refreshStatus, 10000);
</script>
</body>
</html>
